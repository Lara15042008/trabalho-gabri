
/* 1. O box-sizing torna Largura e altura mais previsíveis. */
*::before,
*::after {
box-sizing: border-box;
}
:root {
--fundo: #07111f;
--superficie: #101d2f;
--superficie-clara: #17263a;
--borda: #2d4059;
--texto: #eef6ff;
--texto-suave: #a9bad0;
--destaque: #Seead4;
--destaque-forte: #2dd4bf;
--raio: 18px;
}
body {
}
margin: 0;
min-width: 0;
min-height: 100vh;
background: linear-gradient(145deg, var(--fundo), #0d1b2d);
color: var(--texto);
font-family: Arial, Helvetica, sans-serif;
line-height: 1.5;

button, article {
font: inherit;
}
.topo,
.painel,
footer {
width: min(100% - 2rem, 1120px);
margin-inline: auto;
}
.topo {
display: flex;
justify-content: space-between;
align-items: center;
gap: 1.5rem;
padding-block: 2rem 1.25rem;
}
h1, h2,
P{
margin-top: 0;
}
h1 {
margin-bottom: 0.35rem;
font-size: clamp(1.9rem, 5vw, 3.4rem);
line-height: 1.05;

.subtitulo, .descricao,
.introducao > P,
.demonstracao-box > div > P,
footer {
color: var(--texto-suave);
}
.etiqueta {
margin-bottom: 0.35rem; color: var(--destaque); font-size: 0.78rem;
font-weight: 800;
letter-spacing: 0.13em;
text-transform: uppercase;
}
button {
flex: auto;
padding: 0.75rem 1rem;
border: 1px solid var(--destaque);
border-radius: 999px;
background: transparent; color: var(--texto); cursor: pointer;
}
button:hover,
button:focus-visible {
background: var(--destaque);
color: #86231e;

}
outline: 3px solid rgba(94, 234, 212, 0.24);
outline-offset: 3px;
.painel {
padding-block: 1rem 3rem;
}
.introducao,
.demonstracao-box {
display: grid;
grid-template-columns: minmax(8, 1fr) minmax(248px, 8.7fr);
gap: 2rem;
align-items: end;
margin-bottom: 1.5rem;
}
/* 2. O gap cria espaço entre os cards sem somar margens individuais. */ -grade-cards {
display: grid;
grid-template-columns: repeat (auto-fit, minmax(min(100%, 220px), 1fr)); gap: 1rem;
margin-bottom: 2rem;
/* 3. Cada card demonstra padding, border e conteúdo interno. */ .card-indicador {
min-width: 0;
padding: 1.25rem;
border: 1px solid var(--borda);
border-radius: vart--raio):

}
background: linear-gradient(160deg, var(--superficie-clara), var(--superficie)); box-shadow: 0 16px 38px rgba(0, 0, 0, 0.22);
overflow-wrap: anywhere;
cursor: pointer;
transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
.card-indicador:hover,
.card-indicador:focus-visible,
.card-indicador.selecionado {
border-color: var(--destaque);
box-shadow: 0 18px 44px rgba(45, 212, 191, 0.18);
transform: translateY(-4px);
outline: none;
}
.icone {
display: grid;
place-items: center;
width: 2.7rem;
height: 2.7rem;
margin-bottom: 1em;
border: 1px solid rgba(94, 234, 212, 8.45);
border-radius: 12px;
background: rgba(94, 234, 212, 0.1);
color: var(--destaque);
font-size: 0.78rem;
font-weight: 900;
}
.rotulo {

}
margin-bottom: 0.25rem; color: var(--texto-suave);
font-weight: 700;
.valor {
display: block;
margin-bottom: 0.75rem;
font-size: clamp(2rem, 7vw, 3.25rem);
line-height: 1;
}
.descricao {
margin-bottom: 0;
}
.demonstracao-box {
}
align-items: center;
padding: 1.5rem;
border: 1px solid var(--borda);
border-radius: var(--raio);
background: rgba(16, 29, 47, 0.7);
.box-model {
min-width: 0;
overflow-x: auto;
}
.camada {
display: grid;

}
place-items: center; min-width: 0;
border-radius: 12px;
text-align: center;
.camada > span {
justify-self: start;
margin: 0.25rem;
font-size: 0.72rem;
font-weight: 800;
text-transform: uppercase;
}
.margem {
padding: 0.55rem;
background: #3b2d55;
}
.borda {
width: 100%;
padding: 0.55rem;
background: #7c3f58;
}
.preenchimento {
width: 100%;
padding: 0.7rem;
background: #8a6a28;
}

.conteudo {
width: 100%; min-height: 74px; padding: 1rem;
background: #146b67;
color: white;
font-weight: 800;
}
footer {
display: flex;
justify-content: space-between;
gap: 1rem;
padding-block: 1.25rem 2rem;
border-top: 1px solid var(--borda);
.compacto .grade-cards {
gap: 0.55rem;
}
.compacto .card-indicador {
padding: 0.8rem;
@media (max-width: 700px) {
.topo,
.introducao,
.demonstracao-box,
footer {
grid-template-columns: 1fr;

}
flex-direction: column; align-items: stretch;
.topo,
footer {
display: flex;
}
button {
width: 100%;
}
