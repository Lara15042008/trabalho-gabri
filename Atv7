body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f8fafc;
    color: #172033;
}

.toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 24px;
    background: #0f172a;
    color: #fff;
}

.toolbar nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.toolbar button {
    padding: 9px 14px;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
}

main {
    padding: 30px;
}

@media (max-width: 650px) {
    .toolbar {
        flex-direction: column;
        align-items: stretch;
    }

    .toolbar nav {
        justify-content: center;
    }
}
}
